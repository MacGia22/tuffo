# Canonical site URL for metadata, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://tuffo.app

# Supabase project (Project Settings → API). The publishable key is safe in the browser;
# the secret key is server-only. Legacy names NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and
# SUPABASE_SECRET_KEY are accepted as well.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: waitlist sign-ups accepted per hour across everyone (default 100).
WAITLIST_HOURLY_LIMIT=

# "false" = the home page shows the waitlist instead of "Start free" (match Supabase's
# "Allow new users to sign up"). Unset = open.
SIGNUPS_OPEN=

# Emails allowed to open /app/admin and send beta invitations, comma-separated.
# Unset = nobody.
ADMIN_EMAILS=

# Shared secret for scheduled jobs (Vercel sends it as "Authorization: Bearer …" to
# /api/jobs/*). Any long random string; without it the jobs refuse every call.
CRON_SECRET=

# Photo scanning of store printouts and test strips. Create a key at
# console.anthropic.com; about a cent per scan. Unset = the scan button is hidden.
ANTHROPIC_API_KEY=
# Optional: model for scans (default claude-sonnet-4-6).
SCAN_MODEL=
# Optional scan limits: per user per calendar month (default 30), and across all users
# per UTC day (default 300). The Anthropic console's monthly spend limit is the hard cap.
SCAN_MONTHLY_LIMIT=
SCAN_DAILY_GLOBAL_LIMIT=

# Error reporting (sentry.io). Unset = nothing is sent. The browser reads the DSN at
# build time, so redeploy after changing it. The auth token (plus org and project slugs)
# only uploads source maps during the build; they are not served publicly.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
